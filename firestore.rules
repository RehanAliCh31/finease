rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@finease.app';
    }

    function incomingOwner() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    function existingOwner() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /app_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_metrics/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      match /{userDocument=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /marketplace_partners/{partnerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /welfare_programs/{programId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /welfare_applications/{applicationId} {
      allow create: if isAdmin() || incomingOwner();
      allow get, delete: if isAdmin() || existingOwner();
      allow update: if isAdmin() || (existingOwner() && incomingOwner());
      allow list: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();

      match /{forumDocument=**} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn();
      }
    }

    match /user_reputation/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_user_sync_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /admin_user_actions/{actionId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
